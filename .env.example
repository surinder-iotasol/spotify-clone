# ─────────────────────────────────────────────
# IotaHub — Environment Variables
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────

# MongoDB connection string (e.g. mongodb://localhost:27017/iota-hub)
DATABASE_URL="mongodb://127.0.0.1:27017/iota-hub"

# JWT signing secret (HMAC-SHA256, ≥32 chars recommended)
JWT_SECRET="change-me-to-a-random-string"

# AWS / S3-compatible object storage
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="change-me"
AWS_SECRET_ACCESS_KEY="change-me"
S3_BUCKET_NAME="iota-hub-storage"
S3_ENDPOINT=""
