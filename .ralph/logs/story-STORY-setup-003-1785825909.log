-lg')\n  })\n\n  it('merges object classes with string classes', () => {\n    // twMerge merges: bg-red-500 preserved alongside text-lg, font-bold applied\n    expect(cn('text-lg', { 'bg-red-500': true, 'font-bold': true })).toBe('text-lg bg-red-500 font-bold')\n  })\n})\n","structuredPatch":[{"oldStart":24,"oldLines":7,"newStart":24,"newLines":7,"lines":["   })"," ","   it('merges object classes with string classes', () => {","-    // twMerge merges: bg-red-500 preserved alongside text-lg, font-bold applied","-    expect(cn('text-lg', { 'bg-red-500': true, 'font-bold': true })).toBe('text-lg bg-red-500 font-bold')","+    // twMerge: p-4 overrides p-2, bg-red-500 is non-conflicting so preserved","+    expect(cn('p-2', { 'p-4': true, 'bg-red-500': true })).toBe('p-4 bg-red-500')","   })"," })"]}],"userModified":false,"replaceAll":false}}
